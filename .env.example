NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile keys must belong to the same widget. Keep existing allowed
# hostnames and actions when adding weekly_leader_verification in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCEMENT_ENABLED=false
# Enables the additional server-validated Turnstile check during an official
# run. Keep false unless this environment has the matching server secret,
# allowed hostnames, and the midrun_human_check action configured.
TURNSTILE_MIDRUN_ENABLED=false
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_ENABLED_ACTIONS=otp_request,weekly_leader_verification
# Server-only WhatsApp destination (digits only, country code included). Leave
# empty until claims are operational; never prefix this variable with NEXT_PUBLIC_.
WHATSAPP_CLAIM_DESTINATION=
# Reserved for the future server-to-server rewarded-ad verification webhook.
AD_SSV_PROVIDER=
AD_SSV_WEBHOOK_SECRET=

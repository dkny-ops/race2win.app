NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RTW_ABUSE_HMAC_KEY=
# Required server key >=32 UTF-8 bytes; also signs short-lived OTP admission.
# Rotating it invalidates pending sign-in challenges (request a new code).
TURNSTILE_ENFORCEMENT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_ENABLED_ACTIONS=otp_request
# Server-only WhatsApp destination (digits only, country code included). Leave
# empty until claims are operational; never prefix this variable with NEXT_PUBLIC_.
WHATSAPP_CLAIM_DESTINATION=
# Reserved for the future server-to-server rewarded-ad verification webhook.
AD_SSV_PROVIDER=
AD_SSV_WEBHOOK_SECRET=
